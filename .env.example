# Copiá este archivo a .env.local para probar con valores propios. Los valores reales van en Vercel → Settings → Environment Variables.

# PostHog: la Project API key es pública y ya está en analytics.js; acá solo cambia la del servidor (off la apaga).
POSTHOG_KEY=phc_tPTtLds2LH6udzJtXWcZzHsXyxUrTgxjSDyMmDThg3gz
# Solo servidor y scripts/posthog-query.cjs (lectura de métricas). Secreta: nunca en el código de la página.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=642163
POSTHOG_HOST=https://us.posthog.com

# Panel de cuentas (/admin): su clave (si falta, sirve FEEDBACK_KEY) y las cuentas de prueba que oculta, separadas por comas
ADMIN_KEY=
ADMIN_TEST_USERS=

# Mercado Pago (pago único)
MP_ACCESS_TOKEN=
MP_PRICE=4900
MP_REGULAR_PRICE=9900
PRICE_LABEL=
TECLADO_PREMIUM_USERS=

# Píxel de Meta y API de conversiones
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo mientras se prueba en el Administrador de eventos → Probar eventos (después, borrarla)
META_TEST_EVENT_CODE=
# Dirección pública del sitio (vuelta de Mercado Pago y event_source_url de Meta). En Vercel: https://www.temploninja.com
APP_URL=

# Etiqueta de Google Ads (anuncios de búsqueda): el AW-… y la etiqueta de cada conversión (off la apaga)
GOOGLE_ADS_ID=
GOOGLE_ADS_LABELS=precios=,registro=,practica=,pago=,compra=

# Base de datos (Upstash o cualquier Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# Emails (Resend): bienvenida con link para entrar, links a pedido y seguimiento a quien no vuelve. Sin la clave no se manda nada.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend
EMAIL_FROM=Templo Ninja <hola@temploninja.com>
EMAIL_REPLY_TO=info@temploninja.com
# Firma de los links de baja (si falta, usa CRON_SECRET o ADMIN_KEY)
EMAIL_SECRET=
# Tarea diaria de Vercel (api/cron.js): Vercel la manda sola en el header Authorization
CRON_SECRET=
# Días sin entrar para el recordatorio y para la oferta, precio y horas de la oferta, y tope de mails por día
EMAIL_REMIND_DAYS=3
EMAIL_OFFER_DAYS=7
OFFER_PRICE=3900
OFFER_HOURS=48
EMAIL_MAX_PER_RUN=80
